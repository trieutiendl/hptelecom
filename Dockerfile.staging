FROM nginx:alpine

COPY deploy/nginx-staging.conf /etc/nginx/conf.d/default.conf
COPY index.html script.js server-theme.css /usr/share/nginx/html/
COPY assets/ /usr/share/nginx/html/assets/
COPY baocao/ /usr/share/nginx/html/baocao/
COPY dangky/ /usr/share/nginx/html/dangky/
COPY dangnhap/ /usr/share/nginx/html/dangnhap/
COPY nguoidung/ /usr/share/nginx/html/nguoidung/
COPY nhom/ /usr/share/nginx/html/nhom/
COPY privacy/ /usr/share/nginx/html/privacy/
COPY support/ /usr/share/nginx/html/support/
COPY thuvien/ /usr/share/nginx/html/thuvien/
COPY tonghop/ /usr/share/nginx/html/tonghop/
COPY tongquan/ /usr/share/nginx/html/tongquan/
